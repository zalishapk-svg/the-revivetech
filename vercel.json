{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/health/:path*",
      "destination": "/api/health?path=:path*"
    },
    {
      "source": "/api/debug/:path*",
      "destination": "/api/health?path=debug/:path*"
    },
    {
      "source": "/api/shopify/auth/callback",
      "destination": "/api/shopify/auth?action=callback"
    },
    {
      "source": "/api/shopify/order/:reference",
      "destination": "/api/shopify/order/[reference]?reference=:reference"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


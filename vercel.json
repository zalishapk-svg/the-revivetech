{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?path=sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?path=robots"
    },
    {
      "source": "/cart/c/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/cart/:cartId/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/api/shopify/auth/callback",
      "destination": "/api/index?path=shopify/auth/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}


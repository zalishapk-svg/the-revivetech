{
  "buildCommand": "npm run build:sitemap && npm run build:prerender && vite build && npm run build:prerender",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/sitemap",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?path=robots.txt"
    },
    {
      "source": "/cart/c/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/cart/:cartId/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/api/shopify/auth/callback",
      "destination": "/api/index?path=shopify/auth/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/((?!assets/|favicon|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)).*)",
      "destination": "/api/index?path=__html__&html_path=/$1"
    }
  ]
}

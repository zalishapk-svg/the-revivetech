{
  "buildCommand": "npm run build:sitemap && vite build && npm run build:prerender",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800" },
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/sitemap",
      "destination": "/api/index?path=sitemap.xml"
    },
    {
      "source": "/cart/c/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/cart/:cartId/checkouts/:path*",
      "destination": "/api/index?path=shopify-checkout-redirect"
    },
    {
      "source": "/api/shopify/auth/callback",
      "destination": "/api/index?path=shopify/auth/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    },
    {
      "source": "/((?!assets/|favicon|.*\\.(?:js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot|xml|txt)).*)",
      "destination": "/api/index?path=__html__&html_path=/$1"
    }
  ]
}

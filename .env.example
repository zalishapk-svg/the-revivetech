# ==============================================================================
# BETA TECH SOLUTIONS - ENVIRONMENT VARIABLE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------

# App Base URL (e.g. "https://your-app.vercel.app")
APP_URL="https://your-app.vercel.app"

# Shopify Store Domain
SHOPIFY_SHOP="dbbys1-nd.myshopify.com"
SHOPIFY_STORE_DOMAIN="dbbys1-nd.myshopify.com"

# Shopify App Client Credentials (from Shopify Dev Dashboard)
# Admin API Access Tokens are automatically acquired & cached in Firestore via Client Credentials Grant
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Shopify Webhook HMAC Secret (Uses SHOPIFY_CLIENT_SECRET by default)
SHOPIFY_WEBHOOK_SECRET=""

# Gemini API Key (Server-side AI features)
GEMINI_API_KEY=""

# Firebase Admin SDK Configuration (Server-Side Firestore Cache)
# Standard Firebase / GCP Server Environment Variables
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Alternatively, supply full JSON string:
# FIREBASE_SERVICE_ACCOUNT_KEY=""

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE / PUBLIC ENVIRONMENT VARIABLES (PREFIX WITH VITE_)
# ------------------------------------------------------------------------------

# Public Feature Flags (No secrets here!)


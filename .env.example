# ==============================================================================
# THERE REVIVE TECH - ENVIRONMENT VARIABLE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-ONLY ENVIRONMENT VARIABLES (NEVER EXPOSE TO BROWSER)
# ------------------------------------------------------------------------------

# App Base URL (e.g. "https://therevivetech.com" or "https://your-app.vercel.app")
APP_URL="https://therevivetech.com"

# Shopify Store Domain
SHOPIFY_STORE_DOMAIN="dbbys1-nd.myshopify.com"

# Shopify App OAuth / Client Credentials (from Shopify Dev Dashboard)
# Admin API Access Tokens are automatically acquired & managed via Client Credentials flow using Client ID & Secret
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Shopify Storefront API Access Token (Server-side proxy usage)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""

# Shopify Webhook HMAC Secret (Uses SHOPIFY_CLIENT_SECRET by default)
SHOPIFY_WEBHOOK_SECRET=""

# Gemini API Key (Server-side AI features)
GEMINI_API_KEY=""

# Optional Persistent Session Storage (Upstash Redis / Vercel KV)
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ------------------------------------------------------------------------------
# 2. CLIENT-SAFE / PUBLIC ENVIRONMENT VARIABLES (PREFIX WITH VITE_)
# ------------------------------------------------------------------------------

# Public Store Identifier (Optional, default is handled server-side via /api proxy)
# VITE_SHOPIFY_STORE_DOMAIN="dbbys1-nd.myshopify.com"
